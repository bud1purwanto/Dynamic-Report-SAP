# ==============================================================================
# LUMINA DYNAMIC REPORT - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================

# 1. DATABASE POSTGRESQL
# URL koneksi ke database PostgreSQL utama
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@<HOST_DB>:5432/ABAP_DB
DATABASE_SCHEMA=dynamic_report

# 2. CENTRALIZED IDENTITY (OIDC) & MCP GATEWAY
# Alamat host OIDC issuer dan MCP Gateway (sesuaikan IP/Domain produksi)
DASHBOARD_OIDC_ISSUER=http://192.168.1.162:4000
DASHBOARD_MCP_GATEWAY_URL=http://192.168.1.162:4000/v1/gateway
DASHBOARD_MCP_API_TOKEN=<MCP_API_TOKEN_PRODUCTION>

# 3. SESI & KEAMANAN
# String acak minimal 32 karakter untuk enkripsi cookie dan sesi
SESSION_SECRET=<GENERATE_MIN_32_CHARACTERS_SECRET>
SESSION_EXPIRE_HOURS=24
SCHEDULE_DELEGATION_DAYS=30
SESSION_COOKIE_NAME=sap_session
SESSION_COOKIE_SECURE=auto

# 4. FRONTEND ORIGIN & EXPORT
# Origin frontend / host domain aplikasi
FRONTEND_ORIGIN=http://192.168.1.162:8000
EXPORT_MASK_FIELDS=IBAN,BANKN,BANKL,STCD1,STCD2

# 5. OLLAMA / LLM (OPSIONAL)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# 6. DOCKER EXPOSE PORT
APP_PORT=8000

